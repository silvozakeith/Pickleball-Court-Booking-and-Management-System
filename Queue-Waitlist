int to24Hour(int h, bool isAM) {
    if (isAM) {
        if (h == 12) return 0;
        return h;
    } else {
        if (h == 12) return 12;
        return h + 12;
    }
}


int getKey(Booking b) {
    int startTotal = to24Hour(b.startHour, b.isStartAM) * 100 + b.startMin;
    return b.courtNo * 10000 + startTotal;
